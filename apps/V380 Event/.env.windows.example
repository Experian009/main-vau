# Собственная камера V380. Этот файл не должен попадать в Git.
V380_CAMERA_ID=12345678
V380_USERNAME=admin
V380_PASSWORD=replace-with-temporary-camera-password

# Для запуска и просмотра на этом же компьютере оставьте 127.0.0.1.
# Для просмотра с другого устройства в домашней сети укажите IPv4-адрес Windows 11.
WEBRTC_HOST=127.0.0.1

# Придумайте длинный случайный токен, отличный от пароля камеры.
GATEWAY_TOKEN=replace-with-a-long-random-token

# Локальный event pipeline. Пустые Telegram/TeraBox значения отключают соответствующий outbound-сервис.
INTERNAL_NOTIFY_TOKEN=replace-with-a-second-long-random-token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. start.ps1 auto-detects the Windows proxy; set explicitly if needed.
# Example: TELEGRAM_HTTPS_PROXY=http://127.0.0.1:10808
TELEGRAM_HTTPS_PROXY=
TERABOX_NDUS=
TERABOX_EVENTS_DIR=/V380/events
FFMPEG_BIN=ffmpeg
MOTION_RTSP_URL=rtsp://127.0.0.1:8554/live
DETECT_FPS=2
DETECT_WIDTH=640
DETECT_HEIGHT=360
# Качество сохраняемых event-клипов. -2 сохраняет пропорции исходного видео.
EVENT_RECORD_FPS=10
EVENT_RECORD_WIDTH=1280
EVENT_RECORD_HEIGHT=-2
MIN_CHANGED_RATIO=0.035
CONSECUTIVE_FRAMES=3
PREBUFFER_SECONDS=5
POSTBUFFER_SECONDS=20
COOLDOWN_SECONDS=30
EVENTS_DIR=local-data/events
NOTIFIER_PORT=8090
MOTION_PORT=8091
ARCHIVE_PORT=8092
NOTIFIER_URL=http://127.0.0.1:8090/internal/v1/notify
TELEGRAM_MAX_VIDEO_MB=45
ARCHIVE_INTERVAL_SECONDS=30
ARCHIVE_UPLOAD_TIMEOUT_SECONDS=900

# Дополнительная постоянная запись. Сегменты загружаются в отдельный каталог TeraBox.
CONTINUOUS_DIR=local-data/continuous
CONTINUOUS_SEGMENT_SECONDS=1800
CONTINUOUS_RECORD_AUDIO=true
CONTINUOUS_PORT=8093
CONTINUOUS_ARCHIVE_PORT=8094
CONTINUOUS_ARCHIVE_INTERVAL_SECONDS=30
TERABOX_CONTINUOUS_DIR=/V380/archive
# 0 = не хранить сегменты после подтверждённой загрузки; >0 = оставить N последних локальных сегментов.
CONTINUOUS_MAX_LOCAL_SEGMENTS=0

# Initial states; runtime switches in Настройки сохраняются в local-data and override these values.
MOTION_ENABLED=true
TELEGRAM_ENABLED=true
TERABOX_EVENTS_ENABLED=true
CONTINUOUS_ENABLED=true
CONTINUOUS_ARCHIVE_ENABLED=true
