# Camera credentials stay on the VPS and are never entered into the browser UI.
V380_CAMERA_ID=12345678
V380_USERNAME=admin
V380_PASSWORD=replace-with-temporary-camera-password

# Public VPS IP or DNS name used in WebRTC ICE candidates.
PUBLIC_HOST=203.0.113.10

# Generate a long random value. The browser console stores this token locally.
GATEWAY_TOKEN=replace-with-a-long-random-token

# During local testing use *. For production use the exact published console origin.
ALLOWED_ORIGIN=*
